rules_version = '2';
// TC Checklist: proposed rules. Same paths as today; only verified @totalchb.com Google accounts may read or write.
// (Today's live rules are in firestore.rules.current: any signed-in account.)
// Publish by pasting into Firebase Console > Firestore Database > Rules, after testing (tests/run.mjs).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@totalchb[.]com$');
    }
  }
}
